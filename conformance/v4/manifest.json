{
  "formatVersion": 1,
  "cases": [
    {
      "name": "v4-sealed-typed-bundle",
      "phase": "run-bundle",
      "source": "bundles/typed",
      "entry": "evaluate",
      "args": [{"$int": "1200"}],
      "expect": {
        "kind": "value",
        "value": {"status": "review", "amount": {"$int": "1200"}, "reason": "manual"}
      }
    },
    {
      "name": "v4-bytecode-matches-linked-bundle",
      "phase": "run-bundle-compiled",
      "source": "bundles/typed",
      "entry": "evaluate",
      "args": [{"$int": "1200"}],
      "expect": {
        "kind": "value",
        "value": {"status": "review", "amount": {"$int": "1200"}, "reason": "manual"}
      }
    },
    {
      "name": "v4-bytecode-negative-pattern-branch",
      "phase": "run-bundle-compiled",
      "source": "bundles/typed",
      "entry": "evaluate",
      "args": [{"$int": "-1"}],
      "expect": {
        "kind": "value",
        "value": {"status": "rejected", "reason": "negative"}
      }
    },
    {
      "name": "v4-text-v2-reference-semantics",
      "phase": "run",
      "source": "programs/text-v2.yan",
      "entry": "normalize",
      "args": ["  Straße,语言,AI  "],
      "expect": {
        "kind": "value",
        "value": {
          "trimmed": "Straße,语言,AI",
          "lowercase": "straße,语言,ai",
          "uppercase": "STRASSE,语言,AI",
          "parts": ["Straße", "语言", "AI"],
          "joined": "Straße·语言·AI"
        }
      }
    },
    {
      "name": "v4-text-v2-bytecode-matches-interpreter",
      "phase": "run-compiled",
      "source": "programs/text-v2.yan",
      "entry": "normalize",
      "args": ["  Straße,语言,AI  "],
      "expect": {
        "kind": "value",
        "value": {
          "trimmed": "Straße,语言,AI",
          "lowercase": "straße,语言,ai",
          "uppercase": "STRASSE,语言,AI",
          "parts": ["Straße", "语言", "AI"],
          "joined": "Straße·语言·AI"
        }
      }
    },
    {
      "name": "v4-text-v2-unicode-scalar-substring",
      "phase": "run-compiled",
      "source": "programs/text-v2.yan",
      "entry": "slice",
      "args": ["A语言🦀Z", {"$int": "1"}, {"$int": "4"}],
      "expect": {
        "kind": "value",
        "value": "语言🦀"
      }
    },
    {
      "name": "v4-text-v2-first-class-operation",
      "phase": "run-compiled",
      "source": "programs/text-v2.yan",
      "entry": "lower-all",
      "args": [["AI", "İSTANBUL"]],
      "expect": {
        "kind": "value",
        "value": ["ai", "i̇stanbul"]
      }
    },
    {
      "name": "v4-math-v1-reference-semantics",
      "phase": "run",
      "source": "programs/math-v1.yan",
      "entry": "summarize",
      "args": [
        {"$int": "-42"},
        {"$int": "-10"},
        {"$int": "10"},
        {"$int": "30"}
      ],
      "expect": {
        "kind": "value",
        "value": {
          "abs": {"$int": "42"},
          "sign": {"$int": "-1"},
          "minimum": {"$int": "-42"},
          "maximum": {"$int": "30"},
          "clamped": {"$int": "-10"},
          "gcd": {"$int": "6"}
        }
      }
    },
    {
      "name": "v4-math-v1-bytecode-matches-interpreter",
      "phase": "run-compiled",
      "source": "programs/math-v1.yan",
      "entry": "summarize",
      "args": [
        {"$int": "-42"},
        {"$int": "-10"},
        {"$int": "10"},
        {"$int": "30"}
      ],
      "expect": {
        "kind": "value",
        "value": {
          "abs": {"$int": "42"},
          "sign": {"$int": "-1"},
          "minimum": {"$int": "-42"},
          "maximum": {"$int": "30"},
          "clamped": {"$int": "-10"},
          "gcd": {"$int": "6"}
        }
      }
    },
    {
      "name": "v4-math-v1-invalid-clamp-range",
      "phase": "run-compiled",
      "source": "programs/math-v1.yan",
      "entry": "invalid-range",
      "args": [{"$int": "0"}],
      "expect": {
        "kind": "diagnostic",
        "code": "RUNTIME_LIBRARY_ARGUMENT",
        "message": "math/clamp minimum cannot exceed maximum",
        "details": {}
      }
    },
