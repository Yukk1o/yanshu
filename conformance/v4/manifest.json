    {
      "name": "v4-json-v1-compiled-canonical-stringify-matches",
      "phase": "run-compiled",
      "source": "programs/json-v1.yan",
      "entry": "encode",
      "args": [{"z": {"$int": "2"}, "a": [true, null, "A🦀"]}],
      "expect": {
        "kind": "value",
        "value": {"$ok": "{\"a\":[true,null,\"A🦀\"],\"z\":2}"}
