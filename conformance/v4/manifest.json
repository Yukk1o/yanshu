            "z": {"$int": "2"}
          }
        }
      }
    },
    {
      "name": "v4-json-v1-compiled-parse-matches",
      "phase": "run-compiled",
      "source": "programs/json-v1.yan",
      "entry": "decode",
      "args": ["{\"z\":2,\"a\":[true,null,\"\\u0041\\uD83E\\uDD80\"]}"],
      "expect": {
        "kind": "value",
        "value": {
          "$ok": {
            "a": [true, {"$nil": true}, "A🦀"],
            "z": {"$int": "2"}
          }
        }
      }
    },
    {
      "name": "v4-json-v1-reference-canonical-stringify",
      "phase": "run",
      "source": "programs/json-v1.yan",
      "entry": "encode",
      "args": [{"z": {"$int": "2"}, "a": [true, null, "A🦀"]}],
      "expect": {
        "kind": "value",
        "value": {"$ok": "{\"a\":[true,null,\"A🦀\"],\"z\":2}"}
