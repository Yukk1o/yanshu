    {
      "name": "v4-json-v1-duplicate-key-is-recoverable",
      "phase": "run-compiled",
      "source": "programs/json-v1.yan",
      "entry": "decode",
      "args": ["{\"a\":1,\"a\":2}"],
      "expect": {
        "kind": "value",
        "value": {
          "$err": {
            "code": "JSON_DUPLICATE_KEY",
            "offset": {"$int": "7"}
          }
        }
      }
