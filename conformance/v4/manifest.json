        }
      }
    },
    {
      "name": "v4-json-v1-reference-parse",
      "phase": "run",
      "source": "programs/json-v1.yan",
      "entry": "decode",
      "args": ["{\"z\":2,\"a\":[true,null,\"\\u0041\\uD83E\\uDD80\"]}"],
