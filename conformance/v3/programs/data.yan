(program
  (name conformance-data-v3)
  (version 3)

  (data decision
    (approved amount)
    (review amount reason)
    (rejected reason))

  (def decide
    (fn (amount)
      (cond
        ((< amount 0) (rejected "negative"))
        ((>= amount 1000) (review amount "manual"))
        (else (approved amount)))))

  (def render
    (fn (amount)
      (match (decide amount)
        ((approved value) (map "status" "approved" "amount" value))
        ((review value reason) (map "status" "review" "amount" value "reason" reason))
        ((rejected reason) (map "status" "rejected" "reason" reason))
        (_ (map "status" "invalid")))))

  (export render))
