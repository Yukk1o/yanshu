# Copy values into your shell environment. The application does not load .env.
YANSHU_PROVIDER=deepseek-chat
YANSHU_API_KEY=
YANSHU_BASE_URL=https://api.deepseek.com
YANSHU_MODEL=deepseek-v4-flash
YANSHU_REASONING_EFFORT=high
YANSHU_MAX_OUTPUT_TOKENS=8192
YANSHU_TIMEOUT_SECONDS=120

# Optional Rust shadow execution. Set VERSION and PERCENT together.
YANSHU_SHADOW_VERSION=
YANSHU_SHADOW_PERCENT=
YANSHU_SHADOW_MAX_CONCURRENCY=4
