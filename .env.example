# Copy values into your shell environment. The application does not load .env.
AI_EVOLVE_PROVIDER=deepseek-chat
AI_EVOLVE_API_KEY=
AI_EVOLVE_BASE_URL=https://api.deepseek.com
AI_EVOLVE_MODEL=deepseek-v4-flash
AI_EVOLVE_REASONING_EFFORT=high
AI_EVOLVE_MAX_OUTPUT_TOKENS=8192
AI_EVOLVE_TIMEOUT_SECONDS=120

# Optional Rust shadow execution. Set VERSION and PERCENT together.
AI_EVOLVE_SHADOW_VERSION=
AI_EVOLVE_SHADOW_PERCENT=
AI_EVOLVE_SHADOW_MAX_CONCURRENCY=4
