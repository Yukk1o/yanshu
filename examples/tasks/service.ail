(program
  (name task-service)
  (version 2)
  (capabilities kv clock log)

  (schema task-create
    (object
      (required "id" (string 1 64))
      (required "title" (string 1 120))
      (optional "completed" boolean #f)))

  (schema task-update
    (object
      (optional "title" (string 1 120))
      (optional "completed" boolean)))

  (route GET "/tasks" list-tasks)
  (route POST "/tasks" create-task)
  (route GET "/tasks/:id" get-task)
  (route PUT "/tasks/:id" update-task)
  (route DELETE "/tasks/:id" delete-task)

  (def list-tasks
    (fn (request)
      (api-response 200 (kv-list "task/"))))

  (def get-task
    (fn (request)
      (let ((id (get (get request "params") "id"))
            (task (kv-get (string-append "task/" id) #f)))
        (if task
            (api-response 200 task)
            (api-error 404 "TASK_NOT_FOUND" "task does not exist")))))

  (def create-task
    (fn (request)
      (let ((validated (validate task-create (get request "body"))))
        (if (ok? validated)
            (let ((body (result-value validated))
                  (id (get body "id"))
                  (title (get body "title"))
                  (completed (get body "completed"))
                  (key (string-append "task/" id))
                  (existing (kv-get key #f)))
              (if existing
                  (api-error 409 "TASK_EXISTS" "task id already exists")
                  (let ((now (now-ms))
                        (task (map "id" id
                                   "title" title
                                   "completed" completed
                                   "createdAt" now
                                   "updatedAt" now)))
                    (do (kv-put key task)
                        (log (map "event" "task-created" "id" id))
                        (api-response 201 task)))))
            (api-error 400
                       "VALIDATION_FAILED"
                       "request body failed schema validation"
                       (result-value validated))))))

  (def update-task
    (fn (request)
      (let ((id (get (get request "params") "id"))
            (key (string-append "task/" id))
            (existing (kv-get key #f))
            (body (get request "body")))
        (if existing
            (let ((validated (validate task-update body)))
              (if (ok? validated)
                (let ((normalized (result-value validated))
                      (title (get-or normalized "title" (get existing "title")))
                      (completed (get-or normalized "completed" (get existing "completed")))
                      (updated (map "id" id
                                    "title" title
                                    "completed" completed
                                    "createdAt" (get existing "createdAt")
                                    "updatedAt" (now-ms))))
                  (do (kv-put key updated)
                      (log (map "event" "task-updated" "id" id))
                      (api-response 200 updated)))
                (api-error 400
                           "VALIDATION_FAILED"
                           "request body failed schema validation"
                           (result-value validated))))
            (api-error 404 "TASK_NOT_FOUND" "task does not exist")))))

  (def delete-task
    (fn (request)
      (let ((id (get (get request "params") "id"))
            (key (string-append "task/" id))
            (existing (kv-get key #f)))
        (if existing
            (do (kv-delete key)
                (log (map "event" "task-deleted" "id" id))
                (api-response 200 existing))
            (api-error 404 "TASK_NOT_FOUND" "task does not exist")))))

  (export list-tasks create-task get-task update-task delete-task))
