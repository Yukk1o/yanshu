; text@2 keeps text@1 compatible and adds bounded text transformations.
(program
  (name text-v2-library-demo)
  (version 4)
  (capabilities)
  (libraries (text 2))

  (signature normalize (fn (string) map))
  (def normalize
    (fn (value)
      (let ((trimmed (text/trim value))
            (parts (text/split trimmed ",")))
        (map "lowercase" (text/lowercase trimmed)
             "uppercase" (text/uppercase trimmed)
             "parts" parts
             "joined" (text/join parts " / ")
             "preview" (text/substring trimmed 0
                                       (if (< (text/length trimmed) 8)
                                           (text/length trimmed)
                                           8))))))

  (export normalize))
